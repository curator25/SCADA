{
  "plant": {
    "name": "Baranna3"
  },

  "sources": {
    "failback_check_seconds": 60
  },

  "modbus": {
    "enabled": true,
    "priority": 1,

    "host": "192.168.1.5",
    "port": 502,
    "slave_id": 255,
    "timeout": 1,

    "register_type": "holding",
    "address_base": 40001,
    "register_start": 40500,
    "register_count": 12,

    "word_order": "little",
    "byte_order": "little",

    "reconnect_delay_seconds": 5
  },

  "file_source": {
    "enabled": false,
    "priority": 2,
    "path": "C:/plantdata/live.csv",
    "delimiter": ",",
    "encoding": "utf-8-sig",
    "match_by": "column",
    "timestamp_column": "Timestamp",
    "max_age_seconds": 300
  },

  "mysql_source": {
    "enabled": false,
    "priority": 3,
    "url": "mysql+pymysql://user:password@host:3306/plant?charset=utf8mb4",
    "table": "plant_live",
    "match_by": "column",
    "timestamp_column": "Timestamp",
    "max_age_seconds": 300
  },

  "postgres_source": {
    "enabled": false,
    "priority": 4,
    "url": "postgresql+psycopg://user:password@host:5432/plant",
    "table": "plant_live",
    "match_by": "column",
    "timestamp_column": "Timestamp",
    "max_age_seconds": 300
  },

  "polling": {
    "read_interval_seconds": 1,
    "store_interval_seconds": 60
  },

  "database": {
    "enabled": true,

    "url": "mysql+pymysql://root:1234@localhost:3306/scada?charset=utf8mb4",

    "mysql": {
      "enabled": true,
      "url": "mysql+pymysql://root:1234@localhost:3306/scada?charset=utf8mb4"
    },
    "postgres": {
      "enabled": false,
      "url": "postgresql+psycopg://postgres:1234@localhost:5432/scada"
    },

    "table": "kpi_readings",
    "timestamp_column": "Timestamp",
    "plant_column": "Plant Name",
    "queue_max_bytes": 10485760
  },

  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "cors_origins": ["*"]
  },

  "timezone": "UTC",

  "reports": {
    "timezone": "Asia/Kolkata"
  },

  "kpi": {
    "enabled": true,
    "table": "kpi_metrics",

    "interval_minutes": 5,
    "compute_delay_seconds": 10,
    "min_samples": 3,
    "backfill_on_start": true,

    "energy_mode": "interval_total",

    "month_timezone": "UTC",

    "metrics": [
      {
        "name": "pr",
        "label": "Performance Ratio",
        "column": "PR",
        "unit": "%",
        "decimals": 2
      }
    ],

    "pr": {
      "label": "Performance Ratio",
      "decimals": 2,

      "p_stc_kwp": 23395,
      "temp_coefficient": -0.29,
      "irradiance_threshold": 50,
      "irradiance_ref": 1000,
      "pr_max_valid": 100,

      "irradiance_param": "poa_avg",
      "module_temp_param": "t_mod",
      "energy_param": "energy_05min",

      "poa_max": 2000,
      "tmod_min": -40,
      "tmod_max": 120,
      "energy_max_factor": 1.5,

      "tmod_monthly": [37, 40, 45, 50, 54, 52, 47, 46, 47, 45, 41, 38]
    }
  },

  "parameters": [
    {
      "name": "ghi_avg",
      "label": "GHI Avg",
      "column": "GHI Avg",
      "register": 40500,
      "datatype": "f32",
      "unit": "W/m²",
      "scale": 1,
      "decimals": 3
    },
    {
      "name": "t_env_avg",
      "label": "T° Enviromental Avg",
      "column": "T° Enviromental Avg",
      "register": 40502,
      "datatype": "f32",
      "unit": "°C",
      "scale": 1,
      "decimals": 3
    },
    {
      "name": "poa_avg",
      "label": "POA Avg",
      "column": "POA Avg",
      "register": 40504,
      "datatype": "f32",
      "unit": "W/m²",
      "scale": 1,
      "decimals": 3
    },
    {
      "name": "t_module_avg",
      "label": "T° Module Avg",
      "column": "T° Module Avg",
      "register": 40506,
      "datatype": "f32",
      "unit": "°C",
      "scale": 1,
      "decimals": 3
    },
    {
      "name": "t_mod",
      "label": "T° Mod",
      "column": "T° Mod",
      "register": 40508,
      "datatype": "f32",
      "unit": "°C",
      "scale": 1,
      "decimals": 3,
      "display": false
    },
    {
      "name": "energy_05min",
      "label": "Energy 5Min",
      "column": "Energy",
      "register": 40510,
      "datatype": "f32",
      "unit": "MWh",
      "scale": 1,
      "decimals": 4,
      "display": false
    }
  ]
}
